#!/bin/sh
# Format staged Rust before it becomes a commit.
#
# `cargo fmt --check` is the first thing CI runs, and a red build over
# whitespace tells you nothing you wanted to know. This runs the formatter
# locally instead of reporting on it.
#
# Only files that were ALREADY staged get re-staged. If the formatter also
# touches something you left unstaged on purpose, that change stays unstaged —
# a commit hook must never quietly enlarge the commit you asked for.
#
# Enable once per clone:
#
#     git config core.hooksPath .githooks
#
# Skip it for one commit with `git commit --no-verify`.

set -e

staged=$(git diff --cached --name-only --diff-filter=ACM -- '*.rs')
[ -z "$staged" ] && exit 0

# Git hooks do not inherit an interactive shell's PATH, and rustup installs to
# ~/.cargo/bin — which is on PATH in a terminal and frequently not here. Found
# that the hard way: the hook reported "skipping" on a real commit and did
# nothing, which is worse than no hook, because you stop checking.
if command -v cargo >/dev/null 2>&1; then
	CARGO=cargo
elif [ -x "${CARGO_HOME:-$HOME/.cargo}/bin/cargo" ]; then
	CARGO="${CARGO_HOME:-$HOME/.cargo}/bin/cargo"
else
	echo "pre-commit: cannot find cargo — Rust is NOT formatted for this commit." >&2
	echo "            CI runs 'cargo fmt --check' and will fail. Run it yourself," >&2
	echo "            or put cargo on PATH and amend." >&2
	exit 1
fi

"$CARGO" fmt

# Re-stage only what was staged to begin with, and only if it still exists.
for f in $staged; do
	[ -f "$f" ] && git add -- "$f"
done

exit 0
